<Window x:Class="MpvNet.Windows.MediaLibrary.MediaLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MX 本地媒体库 - mpv.net" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#18181A" Foreground="#E0E0E0"
        FontFamily="Microsoft YaHei, Segoe UI">

    <Window.Resources>
        <!-- 滚动条样式 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1E1E22"/>
        </Style>

        <!-- 顶部 Tab 按钮样式 -->
        <Style x:Key="TabNavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#A0A0A5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2A30"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E50914"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片悬浮动画样式 -->
        <Style x:Key="MediaCardBorder" TargetType="Border">
            <Setter Property="Background" Value="#222226"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#33333A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E2E36"/>
                    <Setter Property="BorderBrush" Value="#E50914"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/> <!-- 顶部导航栏 -->
            <RowDefinition Height="*"/>  <!-- 主内容区 -->
            <RowDefinition Height="36"/> <!-- 底部状态栏 -->
        </Grid.RowDefinitions>

        <!-- 顶部工具栏与分类导航 -->
        <Border Grid.Row="0" Background="#202024" BorderBrush="#2C2C32" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 品牌 Logo 与标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="⚡ MX" FontSize="20" FontWeight="Bold" Foreground="#E50914" VerticalAlignment="Center"/>
                    <TextBlock Text=" 媒体库" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

                <!-- 视图分类 Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="TabAllVideos" Content="🎬 全部视频" Style="{StaticResource TabNavButton}" IsChecked="True" Click="Tab_Click"/>
                    <RadioButton x:Name="TabFolders" Content="📁 文件夹" Style="{StaticResource TabNavButton}" Click="Tab_Click"/>
                    <RadioButton x:Name="TabMusic" Content="🎵 音乐与音频" Style="{StaticResource TabNavButton}" Click="Tab_Click"/>
                </StackPanel>

                <!-- 实时搜索框 -->
                <Border Grid.Column="2" Background="#141416" CornerRadius="8" BorderBrush="#35353C" BorderThickness="1"
                        Height="38" Margin="30,0" VerticalAlignment="Center">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="14" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" x:Name="SearchBox" Background="Transparent" Foreground="#FFFFFF"
                                 BorderThickness="0" VerticalAlignment="Center" FontSize="14"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Border>

                <!-- 操作按钮组 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRescan" Content="🔄 扫描磁盘" Height="36" Padding="14,0"
                            Background="#33333D" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"
                            BorderThickness="0" Cursor="Hand" Click="BtnRescan_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容展示区 -->
        <Grid Grid.Row="1" Margin="20,15,20,10">
            <!-- 1. 全部视频：网格流视图 -->
            <ScrollViewer x:Name="ScrollViewerVideos" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsVideos">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MediaCardBorder}" Width="240" Margin="8,10"
                                    MouseLeftButtonDown="MediaCard_MouseLeftButtonDown">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="135"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 16:9 封面缩略图 -->
                                    <Border Grid.Row="0" CornerRadius="10,10,0,0" Background="#151518" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill"/>
                                            
                                            <!-- 时长药丸标签 -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Background="#CC000000" CornerRadius="4" Padding="6,2" Margin="6">
                                                <TextBlock Text="{Binding DurationString}" FontSize="11" Foreground="#FFFFFF" FontWeight="Medium"/>
                                            </Border>

                                            <!-- 底部续播红条 -->
                                            <ProgressBar Value="{Binding ProgressRatio, Mode=OneWay}" Maximum="1.0"
                                                         VerticalAlignment="Bottom" Height="3" Background="#40000000"
                                                         Foreground="#E50914" BorderThickness="0"/>
                                        </Grid>
                                    </Border>

                                    <!-- 卡片标题与文件信息 -->
                                    <StackPanel Grid.Row="1" Margin="10,8,10,10">
                                        <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding FileSizeString}" FontSize="11" Foreground="#888888"/>
                                            <TextBlock Text=" • " FontSize="11" Foreground="#666666"/>
                                            <TextBlock Text="{Binding DirectoryName}" FontSize="11" Foreground="#888888"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 2. 文件夹归类视图 -->
            <ScrollViewer x:Name="ScrollViewerFolders" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ItemsControl x:Name="ItemsFolders">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MediaCardBorder}" Width="240" Margin="8,10"
                                    MouseLeftButtonDown="FolderCard_MouseLeftButtonDown">
                                <StackPanel Margin="12">
                                    <Border CornerRadius="8" Background="#1A1A1E" Height="100" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding CoverThumbnailPath}" Stretch="UniformToFill" Opacity="0.5"/>
                                            <TextBlock Text="📁" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding FolderName}" FontSize="14" FontWeight="Bold"
                                               Foreground="#FFFFFF" Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding VideoCount, StringFormat='{}{0} 个视频'}"
                                               FontSize="12" Foreground="#888888"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 3. 音乐列表视图 -->
            <ScrollViewer x:Name="ScrollViewerMusic" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ItemsControl x:Name="ItemsMusic">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#202024" CornerRadius="8" Margin="0,4" Padding="12,10"
                                    Cursor="Hand" MouseLeftButtonDown="MediaCard_MouseLeftButtonDown">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🎵" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="{Binding DirectoryName}" FontSize="11" Foreground="#888888"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding FileSizeString}" FontSize="12" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空结果提示 -->
            <StackPanel x:Name="PanelEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="🎬" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="未找到匹配的媒体文件" FontSize="16" Foreground="#888888" HorizontalAlignment="Center"/>
                <TextBlock Text="点击右上角「扫描磁盘」搜索本地影视" FontSize="13" Foreground="#666666" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="#1C1C20" BorderBrush="#28282E" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="就绪" FontSize="12" Foreground="#888888" VerticalAlignment="Center"/>
                <ProgressBar x:Name="ProgressBarScan" Grid.Column="1" Width="150" Height="4"
                             IsIndeterminate="False" Visibility="Collapsed" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
