<Window x:Class="MpvNet.Windows.MediaLibrary.MediaLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MX Media Library - mpv.net" Height="760" Width="1160" MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#141416" Foreground="#F0F0F2"
        FontFamily="Segoe UI, Microsoft YaHei, Arial"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        KeyDown="Window_KeyDown">

        <Window.Resources>
        <local:ThumbnailImageConverter x:Key="ThumbnailConverter" xmlns:local="clr-namespace:MpvNet.Windows.MediaLibrary"/>
        <!-- 滚动条精细半透明样式 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1A1A1E"/>
            <Setter Property="Width" Value="8"/>
        </Style>

        <!-- 分类 Tab 切换按钮 -->
        <Style x:Key="TabNavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#95959E"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="1.5" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25252C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252532"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E50914"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 扁平现代操作按钮 -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#26262E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#383842"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#363642"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#555566"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E50914"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E50914"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 视频卡片样式 -->
        <Style x:Key="MediaCardBorder" TargetType="Border">
            <Setter Property="Background" Value="#1F1F24"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#2F2F38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A33"/>
                    <Setter Property="BorderBrush" Value="#E50914"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 卡片右键菜单 -->
        <ContextMenu x:Key="CardContextMenu">
            <MenuItem x:Name="CtxMenuPlay" Header="▶ 立即播放" Click="CtxMenuPlay_Click"/>
            <MenuItem x:Name="CtxMenuOpenFolder" Header="📂 在文件资源管理器中显示" Click="CtxMenuOpenFolder_Click"/>
            <MenuItem x:Name="CtxMenuCopyPath" Header="📋 复制完整路径" Click="CtxMenuCopyPath_Click"/>
            <Separator/>
            <MenuItem x:Name="CtxMenuRemove" Header="🗑 从媒体库移除" Click="CtxMenuRemove_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/> <!-- 顶部主导航 -->
            <RowDefinition Height="46"/> <!-- 二级工具栏：面包屑/排序/视图切换 -->
            <RowDefinition Height="*"/>  <!-- 媒体展示区 -->
            <RowDefinition Height="34"/> <!-- 底部状态栏 -->
        </Grid.RowDefinitions>

        <!-- 1. 顶部主导航栏 -->
        <Border Grid.Row="0" Background="#1A1A1E" BorderBrush="#26262E" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo 与产品标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <Border CornerRadius="6" Padding="7,2" Margin="0,0,8,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E50914" Offset="0"/>
                                <GradientStop Color="#9B060D" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="MX" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>
                    <TextBlock x:Name="TxtBrandTitle" Text=" 媒体库" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 分类 Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="TabAllVideos" Content="🎬 全部视频" Style="{StaticResource TabNavButton}" IsChecked="True" Click="Tab_Click"/>
                    <RadioButton x:Name="TabFolders" Content="📁 文件夹" Style="{StaticResource TabNavButton}" Click="Tab_Click"/>
                    <RadioButton x:Name="TabMusic" Content="🎵 音乐与音频" Style="{StaticResource TabNavButton}" Click="Tab_Click"/>
                </StackPanel>

                <!-- 实时搜索框（带清空按钮） -->
                <Border Grid.Column="2" Background="#111113" CornerRadius="8" BorderBrush="#2E2E36" BorderThickness="1"
                        Height="38" Margin="24,0" VerticalAlignment="Center" MaxWidth="500">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="13" Foreground="#707078" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" x:Name="SearchBox" Background="Transparent" Foreground="#FFFFFF"
                                 BorderThickness="0" VerticalAlignment="Center" FontSize="13"
                                 TextChanged="SearchBox_TextChanged"/>
                        <!-- 搜索框无内容时的提示占位符 -->
                        <TextBlock Grid.Column="1" x:Name="TxtSearchPlaceholder" Text="搜索媒体、影视剧集或目录..."
                                   FontSize="13" Foreground="#555560" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <!-- 清空按钮 -->
                        <Button Grid.Column="2" x:Name="BtnClearSearch" Content="✖" Foreground="#888888" Background="Transparent"
                                BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Click="BtnClearSearch_Click"
                                Margin="4,0,0,0" ToolTip="清空搜索"/>
                    </Grid>
                </Border>

                <!-- 右侧动作按钮区 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnAddFolder" Content="➕ 添加目录" Style="{StaticResource ActionBtn}" Click="BtnAddFolder_Click"/>
                    <Button x:Name="BtnRescan" Content="🔄 扫描磁盘" Style="{StaticResource ActionBtn}" Click="BtnRescan_Click"/>
                    <!-- 中英语言切换按钮 -->
                    <Button x:Name="BtnLangToggle" Content="中 / EN" Style="{StaticResource ActionBtn}" Background="#3A3A46" Click="BtnLangToggle_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. 二级工具栏：面包屑导航 / 排序 / 网格与列表切换 -->
        <Border Grid.Row="1" Background="#17171A" BorderBrush="#24242A" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：文件夹深入面包屑栏 -->
                <StackPanel x:Name="BreadcrumbPanel" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Button x:Name="BtnBackToFolders" Content="⬅ 返回文件夹列表" Style="{StaticResource ActionBtn}"
                            Background="#222228" Margin="0,0,10,0" Click="BtnBackToFolders_Click"/>
                    <TextBlock x:Name="TxtBreadcrumbFolder" Text="📂 文件夹名称" FontSize="13" FontWeight="SemiBold"
                               Foreground="#E50914" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 默认普通标题/统计 -->
                <TextBlock x:Name="TxtViewHeading" Grid.Column="0" Text="🎬 全部视频" FontSize="13" FontWeight="SemiBold"
                           Foreground="#A0A0AA" VerticalAlignment="Center"/>

                <!-- 右侧：排序与视图切换 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSortLabel" Text="排序:" FontSize="12" Foreground="#888890" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbSort" Width="110" Height="28" Background="#222228" Foreground="#FFFFFF"
                              BorderBrush="#33333D" SelectionChanged="CmbSort_SelectionChanged">
                        <ComboBoxItem x:Name="OptSortDate" Content="最新修改" IsSelected="True"/>
                        <ComboBoxItem x:Name="OptSortName" Content="名称 (A-Z)"/>
                        <ComboBoxItem x:Name="OptSortSize" Content="文件大小"/>
                        <ComboBoxItem x:Name="OptSortDuration" Content="播放时长"/>
                    </ComboBox>

                    <!-- 网格/列表切换切换 -->
                    <RadioButton x:Name="BtnViewGrid" Content="🔲" ToolTip="卡片网格视图" Margin="12,0,2,0"
                                 Style="{StaticResource TabNavButton}" IsChecked="True" Click="ViewMode_Click"/>
                    <RadioButton x:Name="BtnViewList" Content="☰" ToolTip="详细列表视图"
                                 Style="{StaticResource TabNavButton}" Click="ViewMode_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. 主媒体内容区 -->
        <Grid Grid.Row="2" Margin="16,12,16,8">
            <!-- 3.1 视频卡片网格视图 -->
            <ScrollViewer x:Name="ScrollViewerVideosGrid" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsVideosGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MediaCardBorder}" Width="252" Margin="8,10"
                                    ContextMenu="{StaticResource CardContextMenu}"
                                    MouseLeftButtonDown="MediaCard_MouseLeftButtonDown">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="142"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 16:9 封面缩略图 -->
                                    <Border Grid.Row="0" CornerRadius="10,10,0,0" Background="#121215" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource ThumbnailConverter}, ConverterParameter=320}" Stretch="UniformToFill"/>
                                            
                                            <!-- 分辨率标签 (1080P, 4K, 720P) -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Background="#D00A0A12" CornerRadius="4" Padding="5,1" Margin="8">
                                                <TextBlock Text="{Binding Resolution}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                            </Border>
                                            <!-- 时长药丸标签 -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Background="#D9000000" CornerRadius="4" Padding="6,2" Margin="8">
                                                <TextBlock Text="{Binding DurationString}" FontSize="11" Foreground="#FFFFFF" FontWeight="Medium"/>
                                            </Border>

                                            <!-- 底部续播红条 -->
                                            <!-- 悬停即现的流光播放按钮 -->
                                            <Border x:Name="PlayOverlay" Background="#40000000" Opacity="0">
                                                <Border Width="44" Height="44" CornerRadius="22" Background="#E5E50914"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="▶" FontSize="18" Foreground="#FFFFFF"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                </Border>
                                            </Border>
                                            <ProgressBar Value="{Binding ProgressRatio, Mode=OneWay}" Maximum="1.0"
                                                         VerticalAlignment="Bottom" Height="3.5" Background="#40000000"
                                                         Foreground="#E50914" BorderThickness="0"/>
                                        </Grid>
                                    </Border>

                                    <!-- 标题与副信息 -->
                                    <StackPanel Grid.Row="1" Margin="10,8,10,10">
                                        <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding FileSizeString}" FontSize="11" Foreground="#888892"/>
                                            <TextBlock Text=" • " FontSize="11" Foreground="#555560"/>
                                            <TextBlock Text="{Binding DirectoryName}" FontSize="11" Foreground="#888892"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PlayOverlay" Property="Opacity" Value="1"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 3.2 视频精细详细列表视图 -->
            <ScrollViewer x:Name="ScrollViewerVideosList" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ItemsControl x:Name="ItemsVideosList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1C1C21" CornerRadius="8" Margin="0,3" Padding="12,8"
                                    ContextMenu="{StaticResource CardContextMenu}"
                                    Cursor="Hand" MouseLeftButtonDown="MediaCard_MouseLeftButtonDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#292933"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🎬" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="{Binding DirectoryPath}" FontSize="11" Foreground="#787882"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DurationString}" FontSize="12" Foreground="#AAAAAA" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{Binding FileSizeString}" FontSize="12" Foreground="#888888" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 3.3 文件夹归类宫格视图 -->
            <ScrollViewer x:Name="ScrollViewerFolders" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ItemsControl x:Name="ItemsFolders">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MediaCardBorder}" Width="252" Margin="8,10"
                                    MouseLeftButtonDown="FolderCard_MouseLeftButtonDown">
                                <StackPanel Margin="12">
                                    <Border CornerRadius="8" Background="#18181D" Height="110" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding CoverThumbnailPath}" Stretch="UniformToFill" Opacity="0.45"/>
                                            <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding FolderName}" FontSize="14" FontWeight="Bold"
                                               Foreground="#FFFFFF" Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding VideoCount, StringFormat='{}{0} 个视频'}"
                                               FontSize="12" Foreground="#888892"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 3.4 音乐列表视图 -->
            <ScrollViewer x:Name="ScrollViewerMusic" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <ItemsControl x:Name="ItemsMusic">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1C1C21" CornerRadius="8" Margin="0,3" Padding="12,10"
                                    ContextMenu="{StaticResource CardContextMenu}"
                                    Cursor="Hand" MouseLeftButtonDown="MediaCard_MouseLeftButtonDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#292933"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🎵" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock Text="{Binding DirectoryName}" FontSize="11" Foreground="#888892"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding FileSizeString}" FontSize="12" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 空结果提示与拖拽指引 -->
            <StackPanel x:Name="PanelEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="🎬" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                <TextBlock x:Name="TxtEmptyTitle" Text="未找到匹配的媒体文件" FontSize="16" Foreground="#888890" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtEmptySub" Text="点击右上角「扫描磁盘」或直接将视频文件夹拖入此窗口" FontSize="13" Foreground="#666670" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 4. 底部状态栏 -->
        <Border Grid.Row="3" Background="#17171B" BorderBrush="#24242A" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="就绪" FontSize="12" Foreground="#888892" VerticalAlignment="Center"/>
                <ProgressBar x:Name="ProgressBarScan" Grid.Column="1" Width="160" Height="4"
                             IsIndeterminate="False" Visibility="Collapsed" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
