<Window x:Class="MpvNet.Windows.AiFeatures.AiSubtitleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 字幕助手 - mpv.net" Height="380" Width="700" MinHeight="260" MinWidth="480"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="#18181C" Foreground="#EDEDF2"
        FontFamily="Segoe UI, Microsoft YaHei, Arial"
        WindowStyle="None" AllowsTransparency="True" BorderThickness="1.5" BorderBrush="#38BDF8">

    <Window.Resources>
        <!-- 滚动条样式 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Background="#404050" BorderThickness="0"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 单词胶囊卡片样式 -->
        <Style x:Key="WordChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#252532"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#353545"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#323245"/>
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 顶栏 -->
            <RowDefinition Height="Auto"/> <!-- 原文字幕 -->
            <RowDefinition Height="Auto"/> <!-- 中文翻译 -->
            <RowDefinition Height="*"/>    <!-- 重点词汇分析 -->
            <RowDefinition Height="Auto"/> <!-- 底栏与快捷操作 -->
        </Grid.RowDefinitions>

        <!-- 顶栏：标题与操作 -->
        <Grid Grid.Row="0" Margin="0,0,0,12" MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#103850" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                    <TextBlock Text="AI 视听" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                </Border>
                <TextBlock x:Name="TxtTitle" Text="智能字幕精读与即时翻译" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <CheckBox x:Name="ChkAutoSync" Content="自动跟播" IsChecked="True" Foreground="#A0A0B0" FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <Button Content="切换字幕轨" Click="BtnExtractSub_Click" Background="#282836" Foreground="#E0E0E0" Padding="8,3" FontSize="11" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="✕" Click="BtnClose_Click" Background="Transparent" Foreground="#888899" FontSize="14" FontWeight="Bold" Width="24" Height="24" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- 当前原文字幕 -->
        <Border Grid.Row="1" Background="#20202A" CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="当前原文字幕 (Original Audio / Subtitle)" FontSize="11" Foreground="#707085" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtOriginal" Text="[等待视频播放字幕或语音输入...]" FontSize="16" FontWeight="SemiBold" Foreground="#F0F0F5" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 中文即时翻译 -->
        <Border Grid.Row="2" Background="#1D242E" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#253545">
            <StackPanel>
                <TextBlock Text="中文即时翻译 (AI Translation)" FontSize="11" Foreground="#38BDF8" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtTranslation" Text="[暂无翻译]" FontSize="14" Foreground="#E0F2FE" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 重点生词拆解与释义 -->
        <Border Grid.Row="3" Background="#1A1A22" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="台词重点生词解析 (Key Vocabulary &amp; Phonetics)" FontSize="11" Foreground="#707085" Margin="0,0,0,8"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ItemsWordChips">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource WordChipStyle}" ToolTip="{Binding Meaning}" MouseLeftButtonDown="WordChip_MouseLeftButtonDown">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Word}" FontWeight="Bold" Foreground="#38BDF8" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Phonetic}" Foreground="#A0A0B5" FontSize="11" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Pos}" Foreground="#F59E0B" FontSize="10" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Meaning}" Foreground="#D0D0DC" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 底栏：状态与快捷键提示 -->
        <Grid Grid.Row="4">
            <TextBlock x:Name="TxtStatus" Text="💡 提示: 播放中按快捷键 [ Ctrl+Shift+D ] 可快速唤出/隐藏此学习面板" FontSize="11" Foreground="#656578" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="复制台词" Click="BtnCopyDialogue_Click" Background="#262634" Foreground="#D0D0E0" Padding="8,4" FontSize="11" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand"/>
                <Button Content="载入外部字幕 (.srt/.ass)" Click="BtnLoadSub_Click" Background="#262634" Foreground="#D0D0E0" Padding="8,4" FontSize="11" BorderThickness="0" Cursor="Hand"/>
                <Button Content="🌐 在线秒搜字幕" Click="BtnSearchOnlineSub_Click" Background="#262634" Foreground="#38BDF8" Padding="8,4" FontSize="11" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand"/>
                <Button Content="双字幕并显" Click="BtnDualSub_Click" Background="#262634" Foreground="#F59E0B" Padding="8,4" FontSize="11" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
