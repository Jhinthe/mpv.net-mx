<Window x:Class="MpvNet.Windows.AiFeatures.WebRemoteQrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手机无线遥控器 - mpv.net" Height="430" Width="400"
        WindowStartupLocation="CenterScreen" Topmost="True" ResizeMode="NoResize"
        Background="#14141A" Foreground="#EDEDF2"
        FontFamily="Segoe UI, Microsoft YaHei, Arial">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" HorizontalAlignment="Center">
            <TextBlock Text="📱 手机局域网无线遥控" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
            <TextBlock Text="用手机浏览器扫码或访问地址，即可躺在床上遥控播放器" FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 二维码显示区 -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="12" Padding="12" HorizontalAlignment="Center" VerticalAlignment="Center" Width="200" Height="200">
            <Image x:Name="ImgQrCode" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>

        <!-- 访问网址提示 -->
        <StackPanel Grid.Row="3" Margin="0,16,0,12" HorizontalAlignment="Center">
            <TextBlock x:Name="TxtUrl" Text="http://192.168.x.x:8999/" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="TxtUrl_MouseLeftButtonDown" ToolTip="点击复制网址"/>
            <TextBlock Text="（手机需连接同一个家庭 Wi-Fi / 局域网）" FontSize="11" Foreground="#64748B" Margin="0,3,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 底部按钮 -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Button Content="在电脑浏览器打开测试" Click="BtnOpenBrowser_Click" Background="#222230" Foreground="#F1F5F9" Padding="12,8" FontSize="12" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left"/>
            <Button Content="关闭" Click="BtnClose_Click" Background="#222230" Foreground="#94A3B8" Padding="16,8" FontSize="12" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
